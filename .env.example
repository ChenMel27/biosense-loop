# Server authentication. Generate long random values; never commit real secrets.
TEACHER_PASSWORD=replace-with-a-long-unique-password
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PARTICIPANT_CODE_PEPPER=replace-with-at-least-32-random-bytes
CONTENT_PACK_APPROVED=false

# Production persistence. Apply migrations 001_initial.sql and 002_teacher_usability.sql first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Live AI routing requires an API key and one explicitly approved use context.
AI_ROUTING_ENABLED=false
# Use only for researcher or adult demonstrations with synthetic/non-student data.
AI_DEMO_ROUTING_ENABLED=false
# Use only after required approval and safeguards for a study involving minors.
MINOR_DATA_SAFEGUARDS_CONFIRMED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
