# Server authentication. Generate long random values; never commit real secrets.
TEACHER_PASSWORD=replace-with-a-long-unique-password
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PARTICIPANT_CODE_PEPPER=replace-with-at-least-32-random-bytes
CONTENT_PACK_APPROVED=false

# Production persistence. Apply supabase/migrations/001_initial.sql first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# AI routing is deliberately off until all three settings are present and approved.
AI_ROUTING_ENABLED=false
MINOR_DATA_SAFEGUARDS_CONFIRMED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
